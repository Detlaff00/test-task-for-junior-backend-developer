{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.2.0",
    "description": "CRUD API for calendar task instances with recurrence templates, UTC time range and future planning."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with task instances"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List task instances",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create recurrence template and return nearest generated instance",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task instance",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task instance by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task instance and optionally its recurrence template",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task instance or whole series",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["single", "series"], "default": "single" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Daily patient follow-up" },
          "description": { "type": "string", "example": "Call post-op patients" },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "recurrence_kind": {
            "type": "string",
            "enum": ["one_time", "daily", "monthly_day", "specific_dates", "monthly_parity"],
            "example": "daily"
          },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" },
          "start_date": {
            "type": "string",
            "format": "date",
            "example": "2026-04-07"
          },
          "all_day": {
            "type": "boolean",
            "example": true
          },
          "start_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "09:00"
          },
          "end_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "10:00"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": { "type": "string", "example": "Daily patient follow-up" },
          "description": { "type": "string", "example": "Call post-op patients" },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress"
          },
          "recurrence_kind": {
            "type": "string",
            "enum": ["one_time", "daily", "monthly_day", "specific_dates", "monthly_parity"],
            "example": "monthly_parity"
          },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" },
          "start_date": {
            "type": "string",
            "format": "date",
            "example": "2026-04-07"
          },
          "all_day": {
            "type": "boolean",
            "example": false
          },
          "start_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "09:00"
          },
          "end_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "10:00"
          }
        }
      },
      "Recurrence": {
        "type": "object",
        "properties": {
          "every_n_days": { "type": "integer", "minimum": 1, "example": 2 },
          "day_of_month": { "type": "integer", "minimum": 1, "maximum": 31, "example": 31 },
          "months_count": { "type": "integer", "minimum": 1, "maximum": 12, "example": 3 },
          "dates": {
            "type": "array",
            "items": { "type": "string", "format": "date" },
            "example": ["2026-04-12", "2026-05-12"]
          },
          "parity": { "type": "string", "enum": ["odd", "even"], "example": "odd" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "template_id": { "type": "integer", "format": "int64", "example": 10 },
          "title": { "type": "string", "example": "Daily patient follow-up" },
          "description": { "type": "string", "example": "Call post-op patients" },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "recurrence_kind": {
            "type": "string",
            "enum": ["one_time", "daily", "monthly_day", "specific_dates", "monthly_parity"],
            "example": "daily"
          },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" },
          "scheduled_for": {
            "type": "string",
            "format": "date",
            "example": "2026-04-07"
          },
          "all_day": {
            "type": "boolean",
            "example": false
          },
          "start_time": {
            "type": "string",
            "example": "09:00"
          },
          "end_time": {
            "type": "string",
            "example": "10:00"
          },
          "origin": {
            "type": "string",
            "enum": ["manual", "generated"],
            "example": "generated"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-07T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-07T00:00:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "invalid task input: daily requires every_n_days >= 1" }
        }
      }
    }
  }
}
